<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- A TV app: no touchscreen, and it shows up in the TV's app row. -->
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.software.leanback" android:required="false" />

    <!-- Weather from Open-Meteo. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Apps the home screen can open (needed on Android 11+, harmless on the TV's Android 9). -->
    <queries>
        <package android:name="com.netflix.ninja" />
        <package android:name="com.amazon.firetv.youtube" />
    </queries>

    <application
        android:label="Zeno 64"
        android:banner="@drawable/banner"
        android:icon="@drawable/banner"
        android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="landscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
            <!-- Lets Zeno 64 be the TV's home app (chosen with `cmd package set-home-activity`). -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Zeno's channel as the TV screensaver. Turned on with an adb settings command, not automatically. -->
        <service
            android:name=".ZenoDream"
            android:exported="true"
            android:label="Zeno 64"
            android:permission="android.permission.BIND_DREAM_SERVICE">
            <intent-filter>
                <action android:name="android.service.dreams.DreamService" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </service>

        <!-- Zeno's news from the Pi, sent over adb (see ZenoFeedReceiver). DUMP: only adb shell and the system can send it. -->
        <receiver
            android:name=".ZenoFeedReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="dev.jamescronin.zeno64.ZENO_FEED" />
            </intent-filter>
        </receiver>

        <!-- The HOME takeover (see HomeWatcher.kt). Off until switched on over adb. -->
        <service
            android:name=".HomeWatcher"
            android:exported="true"
            android:label="Zeno 64 home"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/home_watcher" />
        </service>
    </application>
</manifest>
